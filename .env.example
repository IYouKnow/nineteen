# Copy to .env next to docker-compose.yml and fill in real values.
# Generate a strong JWT secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-use-openssl-rand-hex-32

# The invite code a new user needs to register the first account.
INVITE_CODE=change-me

# GitHub repo that hosts the Nineteen source (owner/name), e.g. acme/nineteen.
# The self-update feature checks this repo for new releases and clones it to
# rebuild the image.
NINETEEN_REPO=change-me

# Optional: the host port the API + UI are published on.
APP_PORT=8080

# Optional: DNS servers the container uses for outbound name resolution.
# Docker otherwise inherits the host's /etc/resolv.conf, which is empty or
# loopback-only on some hosts — that breaks clones of GitHub/Gitea and any
# outbound lookup with "Could not resolve host". Point these at your own
# resolvers if you rely on internal/split-horizon DNS.
NINETEEN_DNS=1.1.1.1
NINETEEN_DNS_FALLBACK=8.8.8.8
