{
  "name": "DatabaseConnection",
  "type": "object",
  "properties": {
    "database_id": {
      "type": "string"
    },
    "database_name": {
      "type": "string"
    },
    "database_type": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "tables"
      ],
      "default": "all"
    },
    "selected_tables": {
      "type": "string"
    }
  },
  "required": [
    "database_id",
    "project_id"
  ]
}