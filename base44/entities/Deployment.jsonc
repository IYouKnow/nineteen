{
  "name": "Deployment",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "building",
        "ready",
        "error",
        "canceled"
      ],
      "default": "queued"
    },
    "commit_sha": {
      "type": "string"
    },
    "commit_message": {
      "type": "string"
    },
    "branch": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "trigger": {
      "type": "string",
      "enum": [
        "git",
        "manual",
        "redeploy"
      ],
      "default": "git"
    },
    "duration": {
      "type": "number"
    },
    "url": {
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ]
}