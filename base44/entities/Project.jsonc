{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "building",
        "error",
        "idle",
        "stopped"
      ],
      "default": "idle"
    },
    "framework": {
      "type": "string",
      "enum": [
        "nextjs",
        "vite",
        "node",
        "python",
        "static",
        "docker",
        "remix",
        "astro"
      ],
      "default": "node"
    },
    "repository": {
      "type": "string"
    },
    "branch": {
      "type": "string",
      "default": "main"
    },
    "domain": {
      "type": "string"
    },
    "auto_deploy": {
      "type": "boolean",
      "default": true
    },
    "last_deployed_at": {
      "type": "string",
      "format": "date-time"
    },
    "region": {
      "type": "string",
      "default": "fra1"
    },
    "instance_type": {
      "type": "string",
      "default": "nano"
    },
    "color": {
      "type": "string",
      "default": "#3b82f6"
    }
  },
  "required": [
    "name"
  ]
}